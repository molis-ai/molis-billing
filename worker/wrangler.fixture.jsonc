{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "molis-billing-local",
  "main": "rust/build/index.js",
  "build": {
    "command": "node scripts/rust-build.mjs",
    "watch_dir": ["rust/src", "rust/Cargo.toml", "rust/Cargo.lock"],
  },
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "molis-billing-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "BILLING_ORIGIN": "http://127.0.0.1:8788",
    "AUTH_ORIGIN": "http://127.0.0.1:8787",
    "ENVIRONMENT_ID": "billing-local",
  },
}
